{
  "manifest_version": 3,
  "name": "DeepSeek Stream Interceptor",
  "version": "1.6.0",
  "description": "Перехват стрима DeepSeek + мост EventSource + эмуляция Ollama API.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": ["https://chat.deepseek.com/*"],
  "content_scripts": [
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["injected.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://chat.deepseek.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}