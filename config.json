{
    // HTTP-порт сервера (Ollama API + bridge)
    "port": 11434,

    // Таймаут watchdog: сколько ждём stream-done от браузера (мс)
    "watchdogTimeoutMs": 120000,

    // Максимальный размер одного вложения (байт)
    "maxFileBytes": 20971520,

    // Максимальный суммарный размер всех вложений (байт)
    "maxTotalBytes": 52428800,

    /* Ширина консоли для word-wrap.
       Приоритет: -Dds.console.width > env COLUMNS > это значение. */
    "consoleWidth": 120,

    // Печатать входящие JSON-запросы (или задайте --debug)
    "debug": false,

    // URL, который открывают браузеры (в режиме --app)
    "deepseekUrl": "https://chat.deepseek.com/",

    // Имя модели в Ollama / OpenAI API
    "modelName": "DeepSeekCloud",

    // Папка Chrome-расширения (null = не загружать; --extension= переопределяет)
    "extensionDir": null,

    /* ============================================================
       Список браузеров для автоматического запуска.
       Каждый браузер открывается на deepseekUrl в режиме --app
       (без адресной строки и вкладок) со своим профилем
       --user-data-dir. Пустой массив = авто-поиск Chrome.

       Внимание: прямые слеши '/' работают и на Windows
       (Chrome и java.io.File их понимают).

       Пример Windows:
         {"name":"User1",
          "path":"C:/Program Files/Google/Chrome/Application/chrome.exe",
          "userDataDir":"C:/Chrome_Profiles/User1"}

       Пример Linux:
         {"name":"User1",
          "path":"/usr/bin/google-chrome",
          "userDataDir":"/home/user/.chrome-profiles/User1"}

       Пример macOS:
         {"name":"User1",
          "path":"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome",
          "userDataDir":"/Users/user/.chrome-profiles/User1"}
       ============================================================ */
    "browsers": [],

    /* Почтовый клиент — открывается отдельным --app окном
       без своего --user-data-dir. null или "" = не открывать.
       Например: "https://mail.smwrap.ru/webmail" */
    "mailClientUrl": null,

    /* Админка почты — аналогично (без своего профиля).
       Например: "https://mail.smwrap.ru/admin/login" */
    "mailAdminUrl": null
}
